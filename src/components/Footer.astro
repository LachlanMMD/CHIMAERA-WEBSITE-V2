<!-- CHIMAERA site footer (all pages). Styles: css/footer.css. Spec: docs/HOMEPAGE-SPEC.md §3 section 6. -->
<footer class="site-footer" id="footer">
  <div class="site-footer__inner">
    <div class="site-footer__columns">
      <section class="site-footer__newsletter" aria-labelledby="footer-newsletter-heading" data-chalk-target="footer">
        <h2 class="site-footer__heading" id="footer-newsletter-heading">Newsletter</h2>

        <p class="site-footer__copy">New dates reach the newsletter first — before tickets go on sale here.</p>

        <!-- MailerLite embedded form "Footer signup" (double opt-in). Our own markup;
             js/newsletter-form.js posts it in the background. Field names and the
             hidden inputs are MailerLite's — don't rename them. Without JS it posts
             straight to MailerLite in a new tab. -->
        <form class="newsletter-form" action="https://assets.mailerlite.com/jsonp/2715494/forms/201409149212297109/subscribe" method="post" target="_blank" data-newsletter-form>
          <label class="visually-hidden" for="newsletter-email">Email address</label>
          <input class="newsletter-form__input" id="newsletter-email" type="email" name="fields[email]" autocomplete="email" placeholder="your@email.dk" required />
          <input type="hidden" name="ml-submit" value="1" />
          <input type="hidden" name="anticsrf" value="true" />
          <button class="newsletter-form__button" type="submit">Subscribe</button>
        </form>

        <p class="newsletter-form__status" role="status" aria-live="polite" data-newsletter-status></p>

        <p class="newsletter-form__note">We'll email you once to confirm. Unsubscribe anytime. <a href="/privacy/">Privacy policy</a></p>
      </section>

      <nav class="site-footer__nav" aria-labelledby="footer-explore-heading">
        <h2 class="site-footer__heading" id="footer-explore-heading">Explore</h2>

        <ul class="site-footer__list">
          <li><a href="/">Home</a></li>
          <li><a href="/events/">Events</a></li>
          <li><a href="/archive/">Archive</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>

      <section class="site-footer__contact" aria-labelledby="footer-contact-heading">
        <h2 class="site-footer__heading" id="footer-contact-heading">Contact</h2>

        <ul class="site-footer__list">
          <li><a href="mailto:info@chimaeracollective.dk" target="_blank">info@chimaeracollective.dk</a></li>
          <li><a href="https://instagram.com/chimaera.cph" target="_blank">Instagram</a></li>
          <li><a href="https://www.facebook.com/people/Chimaeracph/61582031459001/" target="_blank">Facebook</a></li>
        </ul>
      </section>
    </div>

    <div class="site-footer__bottom">
      <a href="/" class="site-footer__wordmark">
        <img src="/assets/logo/chimaera-wordmark-coral.png" alt="CHIMAERA" width="381" height="103" />
      </a>

      <div class="site-footer__legal">
        <p>CHIMAERA.CPH · Ved Linden 4, 3. th., 2300 København S · CVR 45933091</p>
        <a href="/privacy/">Privacy policy</a>
        <a href="/terms/">Terms &amp; conditions</a>
      </div>
    </div>
  </div>
</footer>
