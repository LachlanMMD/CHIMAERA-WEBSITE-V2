<!-- CHIMAERA persistent chrome: wordmark (top-left) + single star toggle
     (top-right) that opens/closes the left nav panel. Both independently
     switch "ink" (light/dark) via js/header-theme.js as the atmosphere or
     an editorial field passes underneath them, so neither ever disappears
     against its own background. Rendered on every page by src/layouts/Base.astro. -->

<header class="site-header">
  <a href="/" class="wordmark site-header__wordmark" data-ink="on-dark" aria-label="CHIMAERA — home">
    
    <img class="wordmark-img wordmark-img--coral" src="/assets/logo/chimaera-wordmark-coral.png" alt="CHIMAERA" />

    <img class="wordmark-img wordmark-img--white" src="/assets/logo/chimaera-wordmark-white.png" alt=""
      aria-hidden="true" />
  </a>

  <button type="button" id="nav-trigger" class="nav-star-button" data-ink="on-dark" aria-haspopup="true"
    aria-expanded="false" aria-controls="site-nav">
    <span class="visually-hidden">Open menu</span>

    <img class="nav-star-button__img" src="/assets/logo/star.svg" alt="" aria-hidden="true" />
  </button>
</header>