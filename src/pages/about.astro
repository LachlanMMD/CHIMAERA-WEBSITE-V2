---
import Base from "../layouts/Base.astro";
---

<Base
  title={"About — CHIMAERA"}
  description={"CHIMAERA is a Copenhagen creative collective built around one relationship: an artist who brings a practice, and someone meeting it for the first time."}
  path="/about/"
  ogDescription={"A Copenhagen creative collective built around artists and the people who meet them halfway."}
  styles={["/css/page.css"]}
  scripts={["/js/page-chrome.js"]}
>
<main id="main">

  <!-- =======================================================
       ONE SCREEN — intro + who / what / why, then the footer
       ======================================================= -->

  <section class="page-screen field-atmosphere" data-field="coral" aria-labelledby="about-heading">

    <div class="container page-screen__inner">

      <header class="page-screen__intro">
        <p class="eyebrow">about</p>

        <h1 id="about-heading">about</h1>

        <p class="body-copy">
          CHIMAERA is a Copenhagen collective built around one relationship: an artist who brings a practice, and
          someone meeting it for the first time.
        </p>
      </header>

      <div class="page-screen__points">

        <div>
          <h2>who we are</h2>
          <p class="body-copy">A creative community built around art, design and tactile process.</p>
        </div>

        <div>
          <h2>what we do</h2>
          <p class="body-copy">
            We gather artists and the people who meet them halfway. Every gathering is built around that exchange.
          </p>
        </div>

        <div>
          <h2>why we exist</h2>
          <p class="body-copy">
            Because making something beats only consuming it. People leave having made something themselves.
          </p>
        </div>

      </div>

    </div>

  </section>

</main>
</Base>
