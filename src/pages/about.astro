---
import Base from "../layouts/Base.astro";
---

<Base
  title={"About — CHIMAERA"}
  description={"CHIMAERA is a Copenhagen creative collective built around one relationship: an artist who brings a practice, and someone meeting it for the first time."}
  path="/about/"
  ogDescription={"A Copenhagen creative collective built around artists and the people who meet them halfway."}
  styles={["/css/page.css"]}
  scripts={["/js/page-chrome.js"]}
>
<main id="main">


  <!-- =======================================================
       INTRO
       ======================================================= -->

  <section class="page-intro field-atmosphere" data-field="coral" aria-labelledby="about-heading">

    <div class="container">

      <p class="eyebrow">
        about
      </p>

      <h1 id="about-heading">
        about
      </h1>

      <div class="body-copy">
        CHIMAERA is a Copenhagen collective built around one relationship: an artist who brings a practice, and
        someone meeting it for the first time.
      </div>

    </div>

  </section>


  <!-- =======================================================
       WHO
       ======================================================= -->

  <section class="page-section field-atmosphere" data-field="coral" aria-labelledby="who-heading">

    <div class="container">

      <h2 id="who-heading">
        who we are
      </h2>

      <div class="body-copy">
        CHIMAERA is a Copenhagen creative collective — a creative community built around art, design and
        tactile process.
      </div>

    </div>

  </section>


  <!-- =======================================================
       WHAT
       ======================================================= -->

  <section class="page-section field-atmosphere" data-field="coral" aria-labelledby="what-heading">

    <div class="container">

      <h2 id="what-heading">
        what we do
      </h2>

      <div class="body-copy">
        We gather artists and the people who meet them halfway. Some of us bring a practice into the room — a
        craft, a way of working, something we've spent time on. Some of us are trying it for the first time.
        Every gathering is built around that exchange.
      </div>

    </div>

  </section>


  <!-- =======================================================
       WHY
       ======================================================= -->

  <section class="page-section field-atmosphere" data-field="coral" aria-labelledby="why-heading">

    <div class="container">

      <h2 id="why-heading">
        why we exist
      </h2>

      <div class="body-copy">
        Because making something is better than only consuming it. CHIMAERA exists for hands-on process over
        passive consumption — workshops and gatherings where people leave having made something themselves.
      </div>

    </div>

  </section>


</main>
</Base>
