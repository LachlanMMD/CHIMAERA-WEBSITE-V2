---
import Base from "../layouts/Base.astro";
---

<Base
  title={"Contact — CHIMAERA"}
  description={"Get in touch with CHIMAERA, a Copenhagen creative collective."}
  path="/contact/"
  styles={["/css/page.css"]}
  scripts={["/js/page-chrome.js"]}
>
<main id="main">


  <!-- =======================================================
       INTRO
       ======================================================= -->

  <section class="page-intro field-atmosphere" data-field="coral" aria-labelledby="contact-heading">

    <div class="container">

      <p class="eyebrow">
        contact
      </p>

      <h1 id="contact-heading">
        contact
      </h1>

      <div class="body-copy">
        Come make something with us.
      </div>

    </div>

  </section>


  <!-- =======================================================
       GET IN TOUCH
       PLACEHOLDER — no real contact details exist in the project
       yet. Replace this block once you have them.
       ======================================================= -->

  <section class="page-section field-atmosphere" data-field="coral" aria-labelledby="get-in-touch-heading">

    <div class="container">

      <h2 id="get-in-touch-heading">
        get in touch
      </h2>

      <div class="body-copy">
        Email, event listings and social links are being finalised — check back soon, or find CHIMAERA at the
        next gathering.
      </div>

    </div>

  </section>


</main>
</Base>
