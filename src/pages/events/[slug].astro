---
/**
 * One page per event in src/content/events/. Layout and states per
 * docs/HOMEPAGE-SPEC.md §11; styles in public/css/event.css.
 * State comes from the data: past (date has passed), sold out, or upcoming.
 */
import Base from "../../layouts/Base.astro";
import { render } from "astro:content";
import { getEvents, statusOf, formatDate, type EventEntry } from "../../lib/events";

export async function getStaticPaths() {
  const events = await getEvents();

  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

interface Props {
  event: EventEntry;
}

const { event } = Astro.props;
const { data } = event;
const { Content } = await render(event);

const status = statusOf(event);
const when = [formatDate(data.date), data.time].filter(Boolean).join(" · ");
const where = [data.venue, data.area].filter(Boolean).join(" · ");
const details = [
  ["Duration", data.duration],
  ["Bring", data.bring],
  ["Experience", data.experience],
].filter(([, value]) => value);

const description = [data.medium, `at ${data.venue}`, formatDate(data.date)].filter(Boolean).join(" ");
---

<Base
  title={`${data.title} — CHIMAERA`}
  description={description}
  path={`/events/${event.id}/`}
  ogImage={data.poster}
  styles={["/css/event.css"]}
  scripts={["/js/page-chrome.js"]}
  noindex={data.draft}
>
  <main id="main">
    <article class="event-page field-atmosphere" data-field="coral" aria-labelledby="event-title">
      <div class="event-page__inner">
        <a class="event-page__back" href="/#events">← All events</a>

        <div class="event-page__layout">
          <figure class="event-page__poster">
            <div class="event-page__poster-frame">
              {data.poster && <img src={data.poster} alt={`Poster: ${data.title}, ${formatDate(data.date)}`} />}
              {status === "soldout" && <span class="stamp">Sold out</span>}
            </div>
          </figure>

          <div class="event-page__body">
            <header class="event-page__header">
              {data.medium && <p class="event-page__medium">{data.medium}</p>}

              <h1 id="event-title">{data.title}</h1>

              <p class="event-page__when">
                <time datetime={data.time ? `${data.date}T${data.time}` : data.date}>{when}</time><br />
                {where}
              </p>
            </header>

            <div class="event-page__text">
              <Content />
            </div>

            {
              details.length > 0 && (
                <dl class="event-page__details">
                  {details.map(([label, value]) => (
                    <div>
                      <dt>{label}</dt>
                      <dd>{value}</dd>
                    </div>
                  ))}
                </dl>
              )
            }

            {
              status === "upcoming" && (
                <a class="event-page__ticket" href={data.stripeUrl ?? "#"}>
                  {data.price !== undefined ? `Tickets · ${data.price} kr` : "Tickets"} <span aria-hidden="true">→</span>
                </a>
              )
            }

            {
              status === "soldout" && (
                <a class="event-page__waitlist" href="#footer">
                  Join the waitlist
                </a>
              )
            }

            {
              status === "past" && data.photos.length > 0 && (
                <ul class="event-page__photos">
                  {data.photos.map((src) => (
                    <li>
                      <img src={src} alt="" loading="lazy" />
                    </li>
                  ))}
                </ul>
              )
            }

            {
              status === "past" && (
                <a class="event-page__next" href="#footer">
                  Hear about the next one first →
                </a>
              )
            }
          </div>
        </div>
      </div>
    </article>
  </main>
</Base>
